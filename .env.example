# ==============================================================================
# SIGNAL PLATFORM CONFIGURATION TEMPLATE
# Copy this file to .env and populate with your credentials.
# ==============================================================================

# Application Environment (Development | Staging | Production)
APP_ENVIRONMENT=Development

# Database Configuration
# Supported providers: sqlite | postgres
DATABASE_PROVIDER=sqlite
DATABASE_CONNECTION_STRING=Data Source=data/signal.db

# AI Provider Configuration (Zero-cost fallback enabled by default)
# Supported providers: none | ollama | groq | gemini | openai | mock
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL_NAME=
AI_ENDPOINT=http://localhost:11434

# Telegram Bot Interface
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets Integration (via Google Apps Script Web App)
GOOGLE_SHEETS_ENABLED=false
GOOGLE_APPS_SCRIPT_URL=

# Search Provider (Optional for source verification)
# Supported providers: none | duckduckgo | bing | serpapi
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# Local Embedding Provider
# Supported: none | local
EMBEDDING_PROVIDER=none

# Ingestion & Polling Schedules (Cron expressions or intervals)
INGESTION_SCHEDULE_INTERVAL_MINUTES=60
HIGH_PRIORITY_SCHEDULE_INTERVAL_MINUTES=30
DIGEST_MORNING_CRON=0 8 * * *
DIGEST_EVENING_CRON=0 20 * * *
